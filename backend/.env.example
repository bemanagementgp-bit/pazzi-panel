# ============================================
# PAZZI BUNS - ENVIRONMENT VARIABLES
# ============================================
# IMPORTANTE: NUNCA comitear .env con secretos reales
# Copiar este archivo a .env y llenar con valores seguros
# ============================================

# ============ DATABASE (Turso/SQLite) ============
# Obtener en: https://turso.tech
TURSO_CONNECTION_URL=libsql://your-db-name.aws-us-east-1.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJhIjoicnciLCJpYXQiOjE3ODAzNDMyNDUsImlkIjoiMDE5ZGY0YzktYjIwMS03NzI2LTlkNjYtY2YzNGIwYzQ5YWUxIiwicmlkIjoiMGI0YTRmNmQtZjc3NC00NWYzLTlkOGEtYmNjNTY1YWZkN2I2In0.8k1quJ-i0AP6DvlJidfH51xWVQQtnsUS1azUrEANZum6Z-t32RNzSXkFhokf2gOCHAqNMozCY1atCuCK7tZfDg

# ============ SERVER ============
SERVER_PORT=3000
NODE_ENV=development
# En producción: production

# ============ SECURITY - JWT ============
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Mínimo 32 caracteres alfanuméricos
JWT_SECRET=your_jwt_secret_min_32_chars_here

# Expiración de tokens (en horas)
JWT_EXPIRATION=2

# ============ ADMIN CREDENTIALS ============
# Email de administrador (no cambiar frecuentemente)
ADMIN_EMAIL=admin@pazzi.com

# Contraseña hasheada con bcrypt (se generará en setup)
# NO DEBE SER TEXTO PLANO
# Generar con: node -e "console.log(require('bcrypt').hashSync('tu-password', 10))"
ADMIN_PASSWORD_HASH=$2b$10$your_bcrypt_hash_here

# ============ CORS (en producción) ============
# URLs permitidas para acceso desde frontend (separadas por comas)
FRONTEND_URLS=http://localhost:5173,http://localhost:5174

# ============ LOGGING ============
# Nivel de logs: error, warn, info
LOG_LEVEL=info

# Directorio para guardar logs
LOG_DIR=./logs
