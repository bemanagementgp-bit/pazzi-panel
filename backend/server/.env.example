# ============================================
# PAZZI BUNS - ENVIRONMENT VARIABLES
# ============================================
# IMPORTANTE: NUNCA comitear .env con secretos reales
# Copiar este archivo a .env y llenar con valores seguros
# ============================================

# ============ DATABASE (Turso/SQLite) ============
# Obtener en: https://turso.tech
TURSO_CONNECTION_URL=libsql://your-db-name.aws-us-east-1.turso.io
TURSO_AUTH_TOKEN=your_token_here_min_64_chars

# ============ SERVER ============
SERVER_PORT=3000
NODE_ENV=development
# En producción: production

# ============ SECURITY - JWT ============
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Mínimo 32 caracteres alfanuméricos
JWT_SECRET=your_jwt_secret_min_32_chars_here

# Expiración de tokens (en horas)
JWT_EXPIRATION=2

# ============ ADMIN CREDENTIALS ============
# Email de administrador (no cambiar frecuentemente)
ADMIN_EMAIL=admin@pazzi.com

# Contraseña hasheada con bcrypt (se generará en setup)
# NO DEBE SER TEXTO PLANO
# Generar con: node -e "console.log(require('bcrypt').hashSync('tu-password', 10))"
ADMIN_PASSWORD_HASH=$2b$10$your_bcrypt_hash_here

# (Opcional / solo desarrollo) Credenciales de vendedor
# VENDEDOR_EMAIL=vendedor@pazzi.com
# VENDEDOR_PASSWORD_HASH=$2b$10$...

# ============ DEV-ONLY: contraseñas en texto plano ============
# Para habilitar las variables *_PASSWORD_PLAIN (login sin hash) se requiere
# EXPLÍCITAMENTE NODE_ENV != production Y ALLOW_PLAIN_PASSWORDS=true.
# Nunca activar en producción.
# ALLOW_PLAIN_PASSWORDS=false
# ADMIN_PASSWORD_PLAIN=
# VENDEDOR_PASSWORD_PLAIN=

# ============ CORS (en producción) ============
# URLs permitidas para acceso desde frontend (separadas por comas)
FRONTEND_URLS=http://localhost:5173,http://localhost:5174

# ============ LOGGING ============
# Nivel de logs: error, warn, info
LOG_LEVEL=info

# Directorio para guardar logs
LOG_DIR=./logs

# ============ NOTIFICACIONES POR MAIL (Resend) ============
# Avisan por mail cuando un vendedor carga un punto de venta y queda pendiente
# de aprobación. Si una solicitud llega detrás de otra (por ejemplo al importar
# un Excel), se juntan todas en un solo mail.
#
# ⚠️  NUNCA escribas la API key acá: este archivo se sube a GitHub.
#     Va en el .env del servidor, que no se versiona.
#
# Para activarlo, en el .env del servidor:
#   1. Verificar el dominio pazzibuns.com en https://resend.com/domains
#   2. Crear una API key en https://resend.com/api-keys
#   3. Completar las tres variables de abajo y reiniciar la API (pm2 reload pazzi-api)
#
# Mientras falte RESEND_API_KEY, RESEND_FROM o el destinatario, no se envía
# ningún mail: queda un aviso en el log y el panel sigue funcionando igual.

# API key de Resend (empieza con re_)
# RESEND_API_KEY=
# Remitente. El dominio tiene que estar verificado en Resend.
# RESEND_FROM=Pazzi Panel <notificaciones@pazzibuns.com>
# Quién recibe el aviso. Para varios, separar con coma. Si se deja vacío, se usa ADMIN_EMAIL.
# ADMIN_NOTIFY_EMAIL=
# Link del botón "Revisar en el panel"
# PANEL_URL=https://admin.pazzibuns.com
# Ventana para agrupar varias solicitudes en un solo mail (ms). Por defecto 30000.
# NOTIFY_DELAY_MS=30000
